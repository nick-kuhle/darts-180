# API
DARTS180_API_PORT=8787
DARTS180_CORS_ORIGIN=http://localhost:8081
DARTS180_ENV=development

# Phase 2+ — do not commit a real URL or credential
DATABASE_URL=postgres://darts180:darts180@localhost:5432/darts180
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=darts-180-clips

# Mobile app: public development endpoint only. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_DARTS180_API_URL=http://localhost:8787

# Data Lab private collection — configure these only in the existing Vercel project's server runtime.
# Do not set a browser-visible VITE_ Blob/auth value or copy any Blob credential here.
# DARTS180_CAPTURE_ACCESS_MODE=development-consent-v1
# BLOB_STORE_ID=<provided by the linked private Vercel Blob store>
